# Copie este arquivo para ".env" e preencha. NUNCA compartilhe o .env com ninguém.

# Token do bot (Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=

# ID do seu servidor (botão direito no servidor > Copiar ID — precisa do Modo Desenvolvedor ligado)
# Com isso os comandos aparecem na hora. Sem isso, podem levar até 1h.
GUILD_ID=

# Chave da Riot (https://developer.riotgames.com) — a de desenvolvimento expira a cada 24h
RIOT_API_KEY=

# Região: br1 para o servidor Brasil; americas para contas/partidas das Américas
RIOT_PLATFORM=br1
RIOT_REGION=americas
